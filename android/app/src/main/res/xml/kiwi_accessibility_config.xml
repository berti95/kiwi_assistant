<?xml version="1.0" encoding="utf-8"?>
<!--
  Config del AccessibilityService de Kiwi. Limitado a YouTube
  (packageNames) porque su único uso es pulsar el botón "Me gusta" del
  vídeo en reproducción. canRetrieveWindowContent para leer el árbol de
  nodos; canPerformGestures como respaldo si el botón no es clickable y
  hay que tocar por coordenadas. notificationTimeout alto: no
  reaccionamos a eventos, las acciones son on-demand.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_description"
    android:notificationTimeout="1000"
    android:packageNames="com.google.android.youtube" />
