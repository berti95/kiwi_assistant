# Default: let git auto-detect text vs binary, normalize to LF in the index.
* text=auto

# Source files — explicit LF on disk so they work in any shell on any OS.
*.sh        text eol=lf
*.py        text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf
*.java      text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.gradle    text eol=lf
gradlew     text eol=lf
gradlew.bat text eol=crlf

# Windows-only files — CRLF so cmd.exe / PowerShell are happy.
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary files — never touch.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.jar       binary
*.apk       binary
*.aab       binary
*.keystore  binary
*.jks       binary
*.zip       binary
*.tar.gz    binary
